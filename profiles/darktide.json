  "group": "minion_aggro_intensity",
  "values": [
   "low",
   "medium",
   "high"
  ],
  "window": 8,
  "_note": "aggro rising while calm = a fight within ~2-8 s (91%). Counts as combat for `window` seconds so the switch can land on the old song's drop; it does not keep a fight alive (that made one 'fight' last a whole mission).",
